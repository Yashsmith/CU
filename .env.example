# Copy to .env and fill in.
GROQ_API_KEY=
MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
SANDBOX_URL=http://127.0.0.1:7090
SANDBOX_TOKEN=dev-sandbox-token
SANDBOX_BACKEND=mock
MAX_STEPS=30
MAX_RUNTIME=300
STEP_WAIT=0.5
ALLOW_REAL_INPUT=0

# --- V2 model matrix (PRD §38) ---
MODEL_PROVIDER=groq
# groq | gemini | openai_compat | astra
MODEL_NAME=qwen/qwen3.8-27b
MODEL_MODE=vision_actions
# vision_actions | computer | code_execution
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# --- V2 security (PRD §36) ---
# Comma-separated; empty = any https domain (browser goto + code browser).
ALLOWED_DOMAINS=
# Set to 1 to auto-allow destructive confirmations (alt+f4 etc.).
CONFIRM_DESTRUCTIVE=0
